<!DOCTYPE html>
<html>
<head>
  <title>Students</title>
</head>
<body>
  <h1>Students</h1>
  <a href="/students/add">Add Student</a>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Age</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(student => { %>
        <tr>
          <td><%= student.sid %></td>
          <td><%= student.name %></td>
          <td><%= student.age %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
