<!DOCTYPE html>
<html>
<head>
  <title>Lecturers</title>
</head>
<body>
  <h1>Lecturers</h1>

  <!-- Error message display -->
  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <!-- Lecturers Table -->
  <table >
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% lecturers.forEach(lecturer => { %>
        <tr>
          <td><%= lecturer._id %></td>
          <td><%= lecturer.name %></td>
          <td><%= lecturer.did %></td>
          <td><a href="/lecturers/delete/<%= lecturer._id %>">Delete</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  

  <a href="/">Back to Home</a>
</body>
</html>
