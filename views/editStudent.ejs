<!DOCTYPE html>
<html>
<head>
  <title>Update Student</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <h1>Update Student</h1>

  <!-- Display an error message if one exists -->
  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <!-- Edit Student Form -->
  <form method="post" action="/students/edit/<%= student.sid %>">
    <!-- Student ID is displayed but not editable -->
    <label for="sid">Student ID:</label>
    <input type="text" id="sid" name="sid" value="<%= student.sid %>" readonly>
    <br>

    <!-- Update Name field -->
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" value="<%= student.name %>" required>
    <br>

    <!-- Update age field -->
    <label for="age">Age:</label>
    <input type="number" id="age" name="age" value="<%= student.age %>" required>
    <br>

    <!-- Submit -->
    <button type="submit">Update</button>
  </form>

  <a href="/students">Back to Students</a>
</body>
</html>
