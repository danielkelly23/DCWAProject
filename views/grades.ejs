<!DOCTYPE html>
<html>
<head>
  <title>Grades</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <h1>Grades</h1>
  <table>
    <thead>
      <tr>
        <th>Student Name</th>
        <th>Module Name</th>
        <th>Grade</th>
      </tr>
    </thead>
    <tbody><!--get grade table -->
      <% grades.forEach(grade => { %>
        <tr>
          <td><%= grade.student_name %></td><!--Student name-->
          <td><%= grade.module_name %></td><!--Module name-->
          <td><%= grade.grade %></td><!--Student Grade-->
        </tr>
      <% }) %>
    </tbody>
  </table>
  <a href="/">Back to Home</a>
</body>
</html>
